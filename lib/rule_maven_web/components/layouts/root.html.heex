<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Rule Maven" suffix=" · Rule Maven" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={asset_path("assets/css/app.css")} />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/icon-192.svg"} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script src={asset_path("assets/js/theme-init.js")}>
    </script>
    <%!-- asset_path/1: digested URLs in prod (immutable caching, busted per
          deploy), ?v= mtime busters elsewhere — un-digested assets +
          heuristic HTTP caching replay stale JS on plain refresh (hooks
          silently missing after a deploy). --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={asset_path("assets/js/phoenix.js")}
    >
    </script>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={asset_path("assets/js/phoenix_html.js")}
    >
    </script>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={asset_path("assets/js/phoenix_live_view.js")}
    >
    </script>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={asset_path("assets/js/app.js")}
    >
    </script>
  </head>
  <body>
    <div class="phx-disconnected-text">Lost connection. Retrying...</div>
    <div class="app-shell">
      <%!-- Prod is the source of truth: anything done in this dev copy is
            overwritten by the next bin/pull-prod and never reaches users. --%>
      <div :if={Application.get_env(:rule_maven, :dev_routes)} class="dev-banner" role="note">
        Dev copy · changes here never reach rulemaven.com
      </div>
      <header class="header">
        <div class="header-inner">
          <% me =
            assigns[:current_user] || (assigns[:conn] && assigns[:conn].assigns[:current_user]) ||
              (assigns[:conn] && RuleMavenWeb.Layouts.current_user(assigns[:conn])) %>

          <%!-- Brand + version travel together: inline on wider screens, the
                version tucked under the wordmark's end on narrow phones (see
                .header-version in app.css) so it costs the nowrap row no width. --%>
          <div class="header-brand-group">
            <.link navigate={~p"/"} class="header-brand">
              <span class="header-icon">🎲</span>
              <%!-- Mobile stacks "Rule" over "Maven" (see the 768px block) so the
                    theme picker beside it can show a full theme name. --%>
              <span class="header-title">Rule <span class="header-title-accent">Maven</span></span>
            </.link>
            <%!-- Signed-in only: the running version isn't shown to the public. --%>
            <.version_link :if={me} user={me} />
          </div>

          <!-- Desktop nav -->
          <nav class="header-nav" id="header-nav">
            <%= if me && RuleMaven.Users.can?(me, :admin) do %>
              <.link navigate={~p"/admin"} class="nav-link">Dashboard</.link>
              <details class="user-dropdown">
                <summary class="user-dropdown-toggle nav-link">Admin</summary>
                <div
                  class="user-dropdown-menu"
                  style="left:0;right:auto;min-width:160px;max-height:22rem;overflow-y:auto"
                >
                  <div class="user-dropdown-section">Review</div>
                  <.link navigate={~p"/admin/questions"} class="user-dropdown-link">Questions</.link>
                  <.link navigate={~p"/admin/moderation"} class="user-dropdown-link">Moderation</.link>
                  <.link navigate={~p"/admin/audit"} class="user-dropdown-link">Audit Log</.link>
                  <.link navigate={~p"/admin/takedowns"} class="user-dropdown-link">Takedowns</.link>
                  <div class="user-dropdown-section">Manage</div>
                  <.link navigate={~p"/admin/users"} class="user-dropdown-link">Users</.link>
                  <.link navigate={~p"/admin/groups"} class="user-dropdown-link">Groups</.link>
                  <.link navigate={~p"/admin/catalog"} class="user-dropdown-link">Catalog</.link>
                  <.link navigate={~p"/admin/requests"} class="user-dropdown-link">Requests</.link>
                  <div :if={RuleMaven.Users.can?(me, :superadmin)} class="user-dropdown-section">
                    AI &amp; Integrations
                  </div>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/llm"}
                    class="user-dropdown-link"
                  >LLM Provider</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/embeddings"}
                    class="user-dropdown-link"
                  >Embeddings &amp; Proxy</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/automation"}
                    class="user-dropdown-link"
                  >Automation</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/bgg"}
                    class="user-dropdown-link"
                  >BoardGameGeek</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/prompts"}
                    class="user-dropdown-link"
                  >Prompts</.link>
                  <div class="user-dropdown-section">System</div>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/flags"}
                    class="user-dropdown-link"
                  >Feature Flags</.link>
                  <.link navigate={~p"/admin/health"} class="user-dropdown-link">Health</.link>
                  <.link navigate={~p"/admin/usage"} class="user-dropdown-link">Usage &amp; Cost</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/security"}
                    class="user-dropdown-link"
                  >Security</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    navigate={~p"/admin/db"}
                    class="user-dropdown-link"
                  >DB Admin</.link>
                  <.link navigate={~p"/admin/themes"} class="user-dropdown-link">Themes</.link>
                  <.link navigate={~p"/standing"} class="user-dropdown-link">Standing</.link>
                  <.link navigate={~p"/groups"} class="user-dropdown-link">Groups</.link>
                  <.link navigate={~p"/settings"} class="user-dropdown-link">Settings</.link>
                  <.link
                    :if={RuleMaven.Users.can?(me, :superadmin)}
                    href={~p"/oban"}
                    class="user-dropdown-link"
                    target="_blank"
                  >Oban ↗</.link>
                </div>
              </details>
            <% end %>
          </nav>

          <div class="header-right">
            <%!-- Admin drawer toggle rides with the right-hand controls (mobile
                  only via .hamburger's display rule) so it never strands itself
                  mid-header with the brand pushed left. --%>
            <button
              :if={me && RuleMaven.Users.can?(me, :admin)}
              class="hamburger"
              id="hamburger-btn"
              aria-label="Menu"
            >
              <span></span><span></span><span></span>
            </button>
            <div class="header-controls">
              <%!-- Game-theme options aren't rendered here: game pages publish
                    their variant list on the #game-theme marker
                    (data-variants), and the script below folds them into
                    #theme-select as a top optgroup. The ‹ / › buttons step the
                    same select one option at a time (skipping optgroup labels),
                    so a theme can be cycled without opening the native picker —
                    they earn their width on touch, where the dropdown is fiddly. --%>
              <button
                type="button"
                class="theme-nav"
                id="theme-prev"
                aria-label="Previous theme"
                title="Previous theme"
              >‹</button>
              <select
                class="theme-select"
                id="theme-select"
                aria-label="Theme"
                title="Change the site's color theme"
              >
                <optgroup
                  :for={{scheme, entries} <- RuleMaven.Metrics.themes_by_scheme()}
                  label={if scheme == :light, do: "Light", else: "Dark"}
                >
                  <option :for={{slug, label} <- entries} value={slug}>
                    🎨 {label}
                  </option>
                </optgroup>
              </select>
              <button
                type="button"
                class="theme-nav"
                id="theme-next"
                aria-label="Next theme"
                title="Next theme"
              >›</button>
              <%!-- Signed-in users get this inside the account menu instead —
                    the mobile header has no room for it. Signed-out visitors
                    have no menu, so it stays in the header for them. Exactly one
                    #motion-toggle is ever rendered; the script binds by id. --%>
              <button
                :if={!me}
                type="button"
                class="motion-toggle"
                id="motion-toggle"
                aria-pressed="false"
                aria-label="Toggle ambient animations"
                title="Turn ambient animations on/off"
              >
                <span class="motion-toggle-on">✨</span>
                <span class="motion-toggle-off">🌙</span>
              </button>
            </div>

            <%= cond do %>
              <% me -> %>
                <details class="user-dropdown">
                  <summary class="user-dropdown-toggle" aria-label="Account menu">
                    <%!-- .header-user is hidden under 768px, which used to leave
                          this summary empty — an invisible control that was a
                          signed-in visitor's only route to Settings/Log out. --%>
                    <span class="header-user-icon" aria-hidden="true">👤</span>
                    <span class="header-user">{me.username}</span>
                    <%!-- Outside .header-user, which is display:none under 768px:
                          the badge is the only signal of an elevated session, so
                          it must survive the mobile collapse the username doesn't. --%>
                    <RuleMavenWeb.CoreComponents.role_badge user={me} />
                  </summary>
                  <div class="user-dropdown-menu">
                    <div class="user-dropdown-section">Display</div>
                    <button
                      type="button"
                      class="user-dropdown-link motion-toggle motion-toggle--menu"
                      id="motion-toggle"
                      aria-pressed="false"
                      aria-label="Toggle ambient animations"
                    >
                      <%!-- The label names the ACTION, not the state: the span
                            shown while animations are on offers to turn them
                            off. No emoji — the sibling links have no icon
                            column, and a leading glyph would push this row's
                            label out of their shared left edge. --%>
                      <span class="motion-toggle-on">Turn animations off</span>
                      <span class="motion-toggle-off">Turn animations on</span>
                    </button>
                    <div class="user-dropdown-section">Account</div>
                    <.link navigate={~p"/standing"} class="user-dropdown-link">Standing</.link>
                    <.link navigate={~p"/groups"} class="user-dropdown-link">Groups</.link>
                    <.link navigate={~p"/settings"} class="user-dropdown-link">Settings</.link>
                    <.link href={~p"/help"} class="user-dropdown-link">Help &amp; FAQ</.link>
                    <div class="user-dropdown-section">Tours</div>
                    <a href={~p"/"} class="user-dropdown-link" data-tour-replay="games">
                      🧭 Finding games
                    </a>
                    <a href={~p"/"} class="user-dropdown-link" data-tour-replay="game">
                      🧭 Asking questions
                    </a>
                    <a href={~p"/"} class="user-dropdown-link" data-tour-replay="answer">
                      🧭 Understanding answers
                    </a>
                    <.link href={~p"/logout"} class="user-dropdown-link">Log out</.link>
                  </div>
                </details>
              <% true -> %>
                <%!-- With single sign-on, Log in starts it straight away (the /login page only
                      repeats the same button). --%>
                <.form
                  :if={RuleMaven.Auth.Oidc.enabled?()}
                  for={%{}}
                  action={~p"/auth/oidc"}
                  class="nav-link-form"
                >
                  <input type="hidden" name="mode" value="login" />
                  <button type="submit" class="nav-link" data-testid="header-sign-in">Log in</button>
                </.form>
                <.link :if={!RuleMaven.Auth.Oidc.enabled?()} href={~p"/login"} class="nav-link">
                  Log in
                </.link>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Mobile drawer overlay -->
      <div class="drawer-overlay" id="drawer-overlay"></div>
      <div class="drawer" id="drawer">
        <div class="drawer-header">
          <span class="drawer-title">Menu</span>
          <button class="drawer-close" id="drawer-close" aria-label="Close menu">&times;</button>
        </div>
        <nav class="drawer-nav">
          <.link navigate={~p"/"} class="drawer-link">🏠 Home</.link>
          <%= if me && RuleMaven.Users.can?(me, :admin) do %>
            <div class="drawer-section">Admin</div>
            <.link navigate={~p"/admin"} class="drawer-link">Dashboard</.link>
            <div class="drawer-section">Review</div>
            <.link navigate={~p"/admin/questions"} class="drawer-link">Questions</.link>
            <.link navigate={~p"/admin/moderation"} class="drawer-link">Moderation</.link>
            <.link navigate={~p"/admin/audit"} class="drawer-link">Audit Log</.link>
            <.link navigate={~p"/admin/takedowns"} class="drawer-link">DMCA Takedowns</.link>
            <div class="drawer-section">Manage</div>
            <.link navigate={~p"/admin/users"} class="drawer-link">Manage Users</.link>
            <.link navigate={~p"/admin/groups"} class="drawer-link">Groups</.link>
            <.link navigate={~p"/admin/catalog"} class="drawer-link">Game Catalog</.link>
            <.link navigate={~p"/admin/requests"} class="drawer-link">Support Requests</.link>
            <div :if={RuleMaven.Users.can?(me, :superadmin)} class="drawer-section">
              AI &amp; Integrations
            </div>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/llm"}
              class="drawer-link"
            >LLM Provider</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/embeddings"}
              class="drawer-link"
            >Embeddings &amp; Proxy</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/automation"}
              class="drawer-link"
            >Automation</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/bgg"}
              class="drawer-link"
            >BoardGameGeek</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/prompts"}
              class="drawer-link"
            >Prompts</.link>
            <div class="drawer-section">System</div>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/flags"}
              class="drawer-link"
            >Feature Flags</.link>
            <.link navigate={~p"/admin/health"} class="drawer-link">System Health</.link>
            <.link navigate={~p"/admin/usage"} class="drawer-link">Usage &amp; Cost</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/security"}
              class="drawer-link"
            >Security</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              navigate={~p"/admin/db"}
              class="drawer-link"
            >DB Admin</.link>
            <.link navigate={~p"/admin/themes"} class="drawer-link">Theme Usage</.link>
            <.link navigate={~p"/settings"} class="drawer-link">Settings</.link>
            <.link
              :if={RuleMaven.Users.can?(me, :superadmin)}
              href={~p"/oban"}
              class="drawer-link"
              target="_blank"
            >Oban Dashboard ↗</.link>
          <% end %>
          <div class="drawer-section"></div>
          <.link href={~p"/help"} class="drawer-link">📖 Help &amp; FAQ</.link>
          <%= if me do %>
            <.link navigate={~p"/standing"} class="drawer-link">Standing</.link>
            <.link navigate={~p"/groups"} class="drawer-link">Groups</.link>
            <.link href={~p"/logout"} class="drawer-link">Log out</.link>
          <% else %>
            <.form
              :if={RuleMaven.Auth.Oidc.enabled?()}
              for={%{}}
              action={~p"/auth/oidc"}
              class="nav-link-form"
            >
              <input type="hidden" name="mode" value="login" />
              <button type="submit" class="drawer-link">Log in</button>
            </.form>
            <.link :if={!RuleMaven.Auth.Oidc.enabled?()} href={~p"/login"} class="drawer-link">
              Log in
            </.link>
          <% end %>
        </nav>
      </div>

      <%!-- LiveView routes render their own flash_group via the live layout
            (RuleMavenWeb.Layouts.app), which re-renders on every connected
            update — this root-layout flash_group is dead-rendered once and
            never updates after the socket connects, so it's skipped here to
            avoid a duplicate, stale flash box. Controller routes (e.g. login)
            have no live layout, so they keep using this one. --%>
      <%= if !(assigns[:conn] && assigns[:conn].private[:phoenix_live_view]) do %>
        <.flash_group flash={assigns[:flash] || %{}} />
      <% end %>

      <main class="main-content">
        <div class="container">
          {@inner_content}
        </div>
      </main>

      <%!-- Persistent super-admin-only background-job panel. Rendered in the root
            layout (not the app layout) so it stays mounted across live
            navigation; gated to super admins. --%>
      <% panel_user =
        assigns[:current_user] || (assigns[:conn] && assigns[:conn].assigns[:current_user]) ||
          (assigns[:conn] && RuleMavenWeb.Layouts.current_user(assigns[:conn])) %>
      <%= if assigns[:conn] && panel_user && RuleMaven.Users.can?(panel_user, :superadmin) do %>
        {live_render(@conn, RuleMavenWeb.AdminLive.JobPanel, id: "job-panel")}
      <% end %>
    </div>

    <script defer src={asset_path("assets/js/theme-picker.js")}>
    </script>
  </body>
</html>
